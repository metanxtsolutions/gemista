# Razorpay (checkout payments)
# Get these from https://dashboard.razorpay.com/app/keys
# Server-side only — never prefix these with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Postgres (order storage)
# Vercel dashboard -> your project -> Storage -> Create Database (Postgres).
# It injects POSTGRES_URL automatically; only needed manually for local dev.
POSTGRES_URL=

# Admin login for /internal/orders — pick any strong password yourself.
ADMIN_PASSWORD=
