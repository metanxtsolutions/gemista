# Razorpay (checkout payments)
# Get these from https://dashboard.razorpay.com/app/keys
# Server-side only — never prefix these with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Postgres (order storage)
# Vercel dashboard -> your project -> Storage -> Create Database (Postgres).
# It injects POSTGRES_URL automatically; only needed manually for local dev.
POSTGRES_URL=

# Admin login for /internal/orders — pick any strong password yourself.
ADMIN_PASSWORD=

# Customer account sessions (OTP login cookie signing).
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# MSG91 (customer OTP login via SMS)
# Requires an MSG91 account with DLT-registered sender ID and an approved
# OTP template (mandatory for transactional SMS in India). The template
# must expose a variable literally named "OTP".
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
